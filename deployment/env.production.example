# =====================================================================
# SIM-MBG SPPG SUNGAI SELAYUR 1 - TEMPLATE KONFIGURASI PRODUKSI (.ENV)
# Standar Badan Gizi Nasional (BGN) & Keamanan Siber Cloud
# =====================================================================

APP_NAME="SIM-MBG SPPG Sungai Selayur 1"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sppg-selayur1.bgn.go.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# LOGGING PRODUKSI (Daily Rotation)
LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# BASIS DATA PRODUKSI (MySQL / MariaDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sim_mbg_selayur
DB_USERNAME=mbg_user
DB_PASSWORD=GantiPasswordKuatDB123!

# SESI & KEAMANAN COOKIE (Wajib HTTPS di produksi)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# SISTEM BERKAS & ANTRIAN
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# EMAIL NOTIFIKASI & ADUAN KRITIS
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notifikasi@mbg-selayur1.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

